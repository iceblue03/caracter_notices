# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# APIFY_API_TOKEN: required for any live Apify scraping (X/Twitter feed +
# Goods tab). Without it, the app runs fine on bundled sample data only.
# On Vercel: set this in Project Settings → Environment Variables.
APIFY_API_TOKEN="YOUR_APIFY_API_TOKEN"

# Optional: a second token, used only by `bun run scrape-once` (see
# scripts/scrape-once.ts). It spends token 1 down first, then automatically
# falls back to this one — handy when you have two free-credit tokens and
# want a single one-shot bulk pull to use both.
# APIFY_API_TOKEN_2="YOUR_SECOND_APIFY_API_TOKEN"

# --- Optional tuning (all have working defaults; see src/server/*.ts) -----

# Comma-separated X/Twitter handles to scrape instead of the built-in list.
# SCRAPE_ACCOUNTS="handle1,handle2"
# Apify actor id for X/Twitter scraping, and tweets pulled per account.
# Default (parseforge/x-com-scraper) works on the free plan. apidojo/tweet-scraper
# was tried and rejects all API calls without a paid Apify plan — only set this
# to it if you have one.
# APIFY_TWITTER_ACTOR="parseforge/x-com-scraper"
# SCRAPE_PER_ACCOUNT=10

# Apify actor ids for the Goods tab's two marketplaces.
# APIFY_BUNJANG_ACTOR="oxygenated_quagmire/bunjang-market-scraper"
# APIFY_DANGGEUN_ACTOR="oxygenated_quagmire/daangn-market-scraper"
# Comma-separated search keywords, overriding the default "top character + 굿즈" list.
# GOODS_KEYWORDS="지우 굿즈,피카츄 굿즈"
# 당근마켓 is neighborhood-scoped; comma-separated district name(s) to search.
# DANGGEUN_REGIONS="서울 강남구,서울 마포구"
# How many of the most popular characters become search keywords, per platform.
# BUNJANG_SEARCH_TOP_N=20
# DANGGEUN_SEARCH_TOP_N=10
# Max items requested per keyword, per platform (one actor run per keyword).
# GOODS_PER_QUERY=30

# Minimum time between manual "새로고침" scrapes (ms) — cost guard.
# SCRAPE_FORCE_MIN_MS=60000
